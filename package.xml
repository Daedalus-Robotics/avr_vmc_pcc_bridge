<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>avr_vmc_pcc_bridge</name>
  <version>0.0.0</version>
  <description>A bridge to control the custom PCC firmware from ROS2</description>
  <maintainer email="hunterbaker@me.com">Hunter Baker</maintainer>
  <license>LGPL-3.0-only</license>

  <depend>rclcpp</depend>
  <depend>boost</depend>
  <depend>serial</depend>
  <depend>std_srvs</depend>
  <depend>avr_common_interfaces</depend>
  <depend>avr_vmc_pcc_interfaces</depend>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
